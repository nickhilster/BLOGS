{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "git": {
    "deploymentEnabled": false
  },
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/the-doorway-and-the-destination",
      "destination": "/posts/the-doorway-and-the-destination/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/posts/software-is-art-feels-like-home",
      "destination": "/posts/software-is-art-feels-like-home/index.html"
    },
    {
      "source": "/posts/software-is-art-feels-like-home/",
      "destination": "/posts/software-is-art-feels-like-home/index.html"
    }
  ]
}
