---
import { getCollection } from 'astro:content'
import MinimalPostLink from '../components/editorial/MinimalPostLink.astro'
import SectionHeading from '../components/editorial/SectionHeading.astro'
import AmbientBackground from '../components/motion/AmbientBackground.astro'
import HeroWaves from '../components/motion/HeroWaves.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { buildTagIndex, sortPostsByDate } from '../lib/content'
import { getThemeByKey } from '../lib/themes'

const posts = sortPostsByDate(await getCollection('posts'))
const tagIndex = buildTagIndex(posts)
---

<BaseLayout
  title="NikDesign Journal"
  description="Nikhil Khedkar's thoughts, written down as I have them."
  theme={getThemeByKey('signal')}
  colorModeToggle
>
  <AmbientBackground />
  <main class="page-shell">
    <section class="hero">
      <HeroWaves />
      <SectionHeading
        title="NikDesign Journal"
        description="Mostly me thinking out loud. Sometimes it turns into something."
      />
    </section>

    <section>
      <ul class="minimal-post-list">
        {posts.map((post) => (
          <MinimalPostLink post={post} />
        ))}
      </ul>
    </section>

    <section>
      <h2>Tags</h2>
      <ul class="tag-list">
        {tagIndex.map((entry) => (
          <li>
            <a href={`/tags/${entry.slug}`}>{entry.tag} ({entry.count})</a>
          </li>
        ))}
      </ul>
    </section>
  </main>
</BaseLayout>
