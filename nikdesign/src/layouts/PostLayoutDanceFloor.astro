---
import BaseLayout from './BaseLayout.astro'
import { resolvePostIdentity } from '../lib/postIdentity'

const { post, Content } = Astro.props
const { theme, styleVars } = resolvePostIdentity(post)
---

<BaseLayout
  title={`${post.data.title} | NikDesign Journal`}
  description={post.data.description}
  theme={theme}
  identityStyleVars={styleVars}
  markdownAlternate={`/posts/${post.slug}.md`}
>
  <div class="dance-backdrop" data-mode="temple" data-journey="find" aria-hidden="true">
    <div class="dance-backdrop__wash"></div>
    <div class="dance-backdrop__beam"></div>
    <div class="dance-backdrop__grid"></div>
    <div class="dance-backdrop__crowd">
      {Array.from({ length: 28 }).map((_, index) => <span style={`--i:${index}`}></span>)}
    </div>
    <div class="dance-backdrop__words dance-backdrop__words--machine">PERFECT MIX</div>
    <div class="dance-backdrop__words dance-backdrop__words--floor">ONE FLOOR</div>
    <div class="dance-backdrop__words dance-backdrop__words--love">SPREAD LOVE</div>
    <div class="booth-notes">
      <span>READ THE ROOM</span>
      <span>LEAVE SPACE</span>
      <span>TECHNIQUE SERVES THE PERSON</span>
    </div>
  </div>

  <div class="dance-progress" aria-hidden="true"><span></span></div>

  <main class="post-shell post-shell--essay dance-post" data-journey="find">
    <header class="dance-hero">
      <p class="dance-hero__kicker">ONE FLOOR / MANY JOURNEYS</p>
      <h1>{post.data.hero.title}</h1>
      <p class="post-dek">{post.data.hero.dek}</p>
      <div class="post-meta"><span>{post.data.publishedAt}</span></div>

      <div class="journey-console" aria-labelledby="journey-question">
        <p id="journey-question" class="journey-console__question">What brought you here tonight?</p>
        <div class="journey-console__choices" role="group" aria-label="Choose your reason for being on the dance floor">
          <button type="button" data-journey-choice="celebrate">Celebrate</button>
          <button type="button" data-journey-choice="disappear">Disappear for a while</button>
          <button type="button" data-journey-choice="find">Find something</button>
          <button type="button" data-journey-choice="move">Just move</button>
        </div>
        <p class="journey-console__response" aria-live="polite">Tonight, this floor is yours to find something you didn't arrive with.</p>
      </div>

      <button class="platter" type="button" aria-label="An unlabeled control in the DJ booth">
        <span class="platter__disc"><i></i></span>
        <span class="platter__label">33⅓</span>
      </button>
      <p class="platter-hint">Some controls aren't labeled.</p>
    </header>

    <article class="post-body prose dance-body"><Content /></article>

    <section class="dance-outro" aria-label="Closing thought">
      <p>EVERYONE TAKES A DIFFERENT JOURNEY.</p>
      <button type="button" class="spread-love">Spread Love. Spread Music.</button>
      <p class="spread-love__echo" aria-live="polite"></p>
    </section>
  </main>

  <script is:inline>
    (() => {
      const post = document.querySelector('.dance-post');
      const backdrop = document.querySelector('.dance-backdrop');
      const progress = document.querySelector('.dance-progress span');
      const response = document.querySelector('.journey-console__response');
      const journeyButtons = [...document.querySelectorAll('[data-journey-choice]')];
      const platter = document.querySelector('.platter');
      const spread = document.querySelector('.spread-love');
      const echo = document.querySelector('.spread-love__echo');
      if (!post || !backdrop) return;

      const journeyCopy = {
        celebrate: "Tonight, this floor is yours to let joy get bigger than your body can hold.",
        disappear: "Tonight, this floor asks nothing from you except that you stay for the next record.",
        find: "Tonight, this floor is yours to find something you didn't arrive with.",
        move: "Tonight, no explanation is required. Move first. Meaning can catch up later."
      };

      const setJourney = (journey, persist = true) => {
        if (!journeyCopy[journey]) return;
        post.dataset.journey = journey;
        backdrop.dataset.journey = journey;
        if (response) response.textContent = journeyCopy[journey];
        journeyButtons.forEach((button) => {
          button.setAttribute('aria-pressed', button.dataset.journeyChoice === journey ? 'true' : 'false');
        });
        if (persist) {
          try { localStorage.setItem('nikdesign:dance-floor-journey', journey); } catch (_) {}
        }
      };

      let saved = 'find';
      try { saved = localStorage.getItem('nikdesign:dance-floor-journey') || 'find'; } catch (_) {}
      setJourney(saved, false);
      journeyButtons.forEach((button) => button.addEventListener('click', () => setJourney(button.dataset.journeyChoice)));

      const anchors = [
        ['machine', document.getElementById('if-djing-is-technical-the-machine-wins')],
        ['self', document.getElementById('the-person-behind-the-decks')],
        ['floor', document.getElementById('everyone-is-having-a-different-night')],
        ['craft', document.getElementById('the-mix-isnt-the-point')],
        ['cook', document.getElementById('the-cook')],
        ['resume', document.getElementById('maybe-thats-why-it-bothers-me')],
        ['love', document.getElementById('spread-love-spread-music')],
      ].filter(([, el]) => el);

      const update = () => {
        const anchor = window.innerHeight * 0.44;
        let mode = 'temple';
        for (const [candidate, el] of anchors) {
          if (el.getBoundingClientRect().top <= anchor) mode = candidate;
        }
        backdrop.dataset.mode = mode;

        if (progress) {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const ratio = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
          progress.style.transform = `scaleY(${ratio})`;
        }
      };

      let ticking = false;
      const requestUpdate = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => { update(); ticking = false; });
      };
      update();
      window.addEventListener('scroll', requestUpdate, { passive: true });
      window.addEventListener('resize', requestUpdate, { passive: true });

      let platterClicks = 0;
      platter?.addEventListener('click', () => {
        platterClicks += 1;
        platter.classList.toggle('is-spinning');
        if (platterClicks >= 4) {
          document.documentElement.classList.add('booth-mode');
          if (response) response.textContent = 'You found the booth. The mix isn’t the point.';
          platterClicks = 0;
        }
      });

      spread?.addEventListener('click', () => {
        backdrop.classList.remove('love-burst');
        void backdrop.offsetWidth;
        backdrop.classList.add('love-burst');
        const journey = post.dataset.journey || 'find';
        const endings = {
          celebrate: 'Take some of that joy with you.',
          disappear: 'You can come back to yourself now.',
          find: 'Maybe you already found it.',
          move: 'Good. No explanation needed.'
        };
        if (echo) echo.textContent = endings[journey] || endings.find;
      });

      window.addEventListener('pointermove', (event) => {
        if (event.pointerType === 'touch') return;
        backdrop.style.setProperty('--px', `${event.clientX}px`);
        backdrop.style.setProperty('--py', `${event.clientY}px`);
      }, { passive: true });
    })();
  </script>
</BaseLayout>

<style>
  :global(body:has(.dance-post)) {
    background: #08080a;
    overflow-x: clip;
  }

  :global(body:has(.dance-post) .site-header),
  :global(body:has(.dance-post) .site-footer) {
    position: relative;
    z-index: 20;
    background: rgba(6, 6, 9, .72);
    border-color: rgba(255,255,255,.08);
    backdrop-filter: blur(16px);
  }

  .dance-backdrop {
    --px: 50vw;
    --py: 42vh;
    --journey-tint: rgba(214, 170, 91, .13);
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background: #09080a;
    transition: background 1.2s ease;
  }

  .dance-backdrop[data-journey='celebrate'] { --journey-tint: rgba(255, 75, 148, .14); }
  .dance-backdrop[data-journey='disappear'] { --journey-tint: rgba(68, 94, 190, .14); }
  .dance-backdrop[data-journey='find'] { --journey-tint: rgba(214, 170, 91, .13); }
  .dance-backdrop[data-journey='move'] { --journey-tint: rgba(52, 184, 158, .13); }

  .dance-backdrop__wash,
  .dance-backdrop__beam,
  .dance-backdrop__grid,
  .dance-backdrop__crowd,
  .dance-backdrop__words,
  .booth-notes {
    position: absolute;
    inset: 0;
  }

  .dance-backdrop__wash {
    background:
      radial-gradient(circle at var(--px) var(--py), rgba(255,255,255,.08), transparent 18rem),
      radial-gradient(circle at 50% 18%, var(--journey-tint), transparent 37%),
      radial-gradient(circle at 16% 82%, rgba(119, 78, 42, .12), transparent 32%),
      linear-gradient(180deg, #17100c 0%, #09080a 72%);
    transition: background 1s ease;
  }

  .dance-backdrop__beam {
    inset: -20% auto -20% 50%;
    width: 34vw;
    transform: translateX(-50%) rotate(7deg);
    transform-origin: 50% 0;
    opacity: .13;
    filter: blur(15px);
    background: linear-gradient(to bottom, rgba(255,224,170,.8), transparent 70%);
    animation: beam-drift 9s ease-in-out infinite alternate;
    transition: opacity .8s ease, filter .8s ease;
  }

  .dance-backdrop__grid {
    opacity: 0;
    background-image:
      linear-gradient(rgba(96,211,255,.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(96,211,255,.05) 1px, transparent 1px);
    background-size: 44px 44px;
    transform: perspective(520px) rotateX(65deg) scale(1.6) translateY(22%);
    transform-origin: 50% 100%;
    transition: opacity .8s ease;
  }

  .dance-backdrop__crowd {
    inset: auto 4vw 5vh;
    height: 28vh;
    opacity: 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-around;
    transition: opacity 1s ease;
  }

  .dance-backdrop__crowd span {
    display: block;
    width: clamp(5px, .65vw, 10px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgba(255,255,255,.28);
    box-shadow: 0 0 22px rgba(255,255,255,.15);
    transform: translateY(calc((var(--i) % 7) * -10px));
    animation: crowd-breathe calc(3.5s + (var(--i) % 5) * .65s) ease-in-out infinite alternate;
  }

  .dance-backdrop__words {
    display: grid;
    place-items: center;
    opacity: 0;
    font-family: var(--font-post-mono, monospace);
    font-size: clamp(5rem, 19vw, 18rem);
    font-weight: 800;
    letter-spacing: -.09em;
    white-space: nowrap;
    color: rgba(255,255,255,.045);
    transition: opacity .9s ease, transform 1.1s ease, filter 1s ease;
  }

  .dance-backdrop__words--machine { transform: scale(.84); color: rgba(91,204,255,.065); }
  .dance-backdrop__words--floor { transform: scale(1.1); }
  .dance-backdrop__words--love { transform: scale(.88); color: rgba(255,196,115,.07); }

  .booth-notes {
    opacity: 0;
    transition: opacity .5s ease;
    font-family: var(--font-post-mono, monospace);
    font-size: .62rem;
    letter-spacing: .15em;
    color: rgba(255,255,255,.2);
  }
  .booth-notes span { position: absolute; }
  .booth-notes span:nth-child(1) { left: 5vw; top: 28vh; transform: rotate(-90deg); }
  .booth-notes span:nth-child(2) { right: 6vw; top: 62vh; }
  .booth-notes span:nth-child(3) { left: 50%; bottom: 4vh; transform: translateX(-50%); }
  :global(.booth-mode) .booth-notes { opacity: 1; }

  .dance-backdrop[data-mode='machine'] { background: #02070a; }
  .dance-backdrop[data-mode='machine'] .dance-backdrop__wash {
    background: radial-gradient(circle at var(--px) var(--py), rgba(78,203,255,.10), transparent 16rem), linear-gradient(180deg, #06131a, #030609 72%);
  }
  .dance-backdrop[data-mode='machine'] .dance-backdrop__beam { opacity: .04; filter: blur(28px); }
  .dance-backdrop[data-mode='machine'] .dance-backdrop__grid,
  .dance-backdrop[data-mode='machine'] .dance-backdrop__words--machine { opacity: 1; }
  .dance-backdrop[data-mode='machine'] .dance-backdrop__words--machine { transform: scale(1); }

  .dance-backdrop[data-mode='self'] .dance-backdrop__wash {
    background: radial-gradient(circle at 68% 30%, rgba(139,76,186,.18), transparent 34%), radial-gradient(circle at 30% 60%, var(--journey-tint), transparent 38%), #09070d;
  }
  .dance-backdrop[data-mode='self'] .dance-backdrop__beam { opacity: .1; transform: translateX(-30%) rotate(-13deg); }

  .dance-backdrop[data-mode='floor'] .dance-backdrop__wash {
    background: radial-gradient(circle at 50% 48%, var(--journey-tint), transparent 30%), radial-gradient(circle at 18% 28%, rgba(183,60,135,.16), transparent 27%), radial-gradient(circle at 82% 30%, rgba(45,119,181,.15), transparent 28%), #07070a;
  }
  .dance-backdrop[data-mode='floor'] .dance-backdrop__crowd,
  .dance-backdrop[data-mode='floor'] .dance-backdrop__words--floor { opacity: 1; }
  .dance-backdrop[data-mode='floor'] .dance-backdrop__words--floor { transform: scale(1); }
  .dance-backdrop[data-mode='floor'] .dance-backdrop__beam { opacity: .22; }

  .dance-backdrop[data-mode='craft'] .dance-backdrop__wash {
    background: radial-gradient(circle at var(--px) var(--py), rgba(255,112,86,.12), transparent 14rem), radial-gradient(circle at 50% 32%, var(--journey-tint), transparent 36%), #100806;
  }
  .dance-backdrop[data-mode='craft'] .dance-backdrop__beam { opacity: .18; transform: translateX(-65%) rotate(16deg); }

  .dance-backdrop[data-mode='cook'] .dance-backdrop__wash {
    background: radial-gradient(circle at 32% 30%, rgba(236,136,61,.21), transparent 31%), radial-gradient(circle at 70% 68%, var(--journey-tint), transparent 33%), #100a07;
  }
  .dance-backdrop[data-mode='cook'] .dance-backdrop__beam { opacity: .1; }

  .dance-backdrop[data-mode='resume'] .dance-backdrop__wash {
    background: radial-gradient(circle at 62% 30%, rgba(73,111,177,.17), transparent 34%), radial-gradient(circle at 35% 68%, var(--journey-tint), transparent 31%), #070a10;
  }
  .dance-backdrop[data-mode='resume'] .dance-backdrop__beam { opacity: .06; }

  .dance-backdrop[data-mode='love'] .dance-backdrop__wash {
    background: radial-gradient(circle at 50% 38%, rgba(255,195,105,.24), transparent 32%), radial-gradient(circle at 50% 70%, var(--journey-tint), transparent 36%), linear-gradient(180deg, #1b1009, #090708 76%);
  }
  .dance-backdrop[data-mode='love'] .dance-backdrop__words--love { opacity: 1; transform: scale(1); }
  .dance-backdrop[data-mode='love'] .dance-backdrop__beam { opacity: .25; filter: blur(11px); }

  .dance-backdrop.love-burst .dance-backdrop__wash { animation: love-burst 1.35s ease-out; }

  .dance-progress {
    position: fixed;
    z-index: 18;
    top: 20vh;
    right: max(12px, 2vw);
    width: 2px;
    height: 60vh;
    background: rgba(255,255,255,.08);
    pointer-events: none;
  }
  .dance-progress span {
    display: block;
    width: 100%;
    height: 100%;
    transform: scaleY(0);
    transform-origin: top;
    background: linear-gradient(to bottom, rgba(255,255,255,.25), rgba(226,179,100,.85));
  }

  .dance-post { position: relative; z-index: 5; }

  .dance-hero {
    position: relative;
    width: var(--reading-width);
    min-height: min(92vh, 61rem);
    margin: 0 auto 5rem;
    padding: 5rem 0 3rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .dance-hero__kicker {
    margin: 0 0 1.5rem;
    font-family: var(--font-post-mono, monospace);
    font-size: .68rem;
    letter-spacing: .18em;
    color: rgba(244,240,232,.5);
  }

  .dance-hero h1 {
    max-width: 10ch;
    font-size: clamp(3.7rem, 9.2vw, 8.8rem);
    line-height: .89;
    letter-spacing: -.06em;
  }

  .journey-console {
    margin-top: 4rem;
    padding: 1.25rem 0 0;
    border-top: 1px solid rgba(255,255,255,.12);
  }
  .journey-console__question {
    margin: 0 0 .8rem;
    font-family: var(--font-post-mono, monospace);
    font-size: .68rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: rgba(255,255,255,.48);
  }
  .journey-console__choices { display: flex; flex-wrap: wrap; gap: .55rem; }
  .journey-console__choices button {
    appearance: none;
    border: 1px solid rgba(255,255,255,.16);
    border-radius: 999px;
    padding: .58rem .85rem;
    background: rgba(8,8,10,.34);
    color: rgba(255,255,255,.7);
    font: inherit;
    font-size: .78rem;
    cursor: pointer;
    transition: background .2s ease, color .2s ease, border-color .2s ease, transform .2s ease;
  }
  .journey-console__choices button:hover { transform: translateY(-1px); border-color: rgba(255,255,255,.32); color: #fff; }
  .journey-console__choices button[aria-pressed='true'] { background: rgba(255,255,255,.12); border-color: rgba(226,179,100,.7); color: #fff; }
  .journey-console__response { min-height: 1.5em; margin: 1rem 0 0; color: rgba(255,255,255,.7); font-style: italic; }

  .platter {
    position: absolute;
    right: -7rem;
    bottom: 8rem;
    width: 5.3rem;
    height: 5.3rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: rgba(255,255,255,.45);
    cursor: pointer;
  }
  .platter__disc {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: repeating-radial-gradient(circle, #19191e 0 2px, #101014 2px 4px);
    box-shadow: 0 0 0 1px rgba(255,255,255,.12), 0 12px 40px rgba(0,0,0,.42);
    transition: transform .5s cubic-bezier(.2,.8,.2,1);
  }
  .platter__disc::before { content: ''; position: absolute; inset: 34%; border-radius: 50%; background: #b48a4b; box-shadow: inset 0 0 0 1px rgba(255,255,255,.16); }
  .platter__disc i { position: absolute; width: 4px; height: 4px; border-radius: 50%; background: #e8e1d6; left: calc(50% - 2px); top: calc(50% - 2px); z-index: 2; }
  .platter__label { position: absolute; inset: 0; display: grid; place-items: center; z-index: 3; font-family: var(--font-post-mono, monospace); font-size: .48rem; color: rgba(0,0,0,.68); }
  .platter.is-spinning .platter__disc { transform: rotate(720deg); }
  .platter-hint { position: absolute; right: -9.2rem; bottom: 5.6rem; width: 9rem; margin: 0; font-family: var(--font-post-mono, monospace); font-size: .52rem; letter-spacing: .08em; color: rgba(255,255,255,.22); text-align: center; }

  :global(.dance-body) {
    position: relative;
    padding: .5rem 1.25rem 4rem;
    background: linear-gradient(180deg, rgba(7,7,10,.36), rgba(7,7,10,.5));
    border: 1px solid rgba(255,255,255,.055);
    border-radius: 2px;
    backdrop-filter: blur(2px);
  }
  :global(.dance-body h2) {
    scroll-margin-top: 7rem;
    margin-top: 7rem;
    font-size: clamp(2.5rem, 5.3vw, 4.9rem);
    line-height: .94;
    letter-spacing: -.045em;
    color: #f6f0e5;
  }
  :global(.dance-body h2::before) {
    content: 'SIDE B / ';
    display: block;
    margin-bottom: .75rem;
    font-family: var(--font-post-mono, monospace);
    font-size: .58rem;
    line-height: 1;
    letter-spacing: .16em;
    color: rgba(226,179,100,.5);
  }
  :global(.dance-body #if-djing-is-technical-the-machine-wins::before) { content: '01 / THE MACHINE'; color: rgba(91,204,255,.65); }
  :global(.dance-body #the-person-behind-the-decks::before) { content: '02 / THE PERSON'; }
  :global(.dance-body #everyone-is-having-a-different-night::before) { content: '03 / THE FLOOR'; }
  :global(.dance-body #the-mix-isnt-the-point::before) { content: '04 / THE CRAFT'; }
  :global(.dance-body #the-cook::before) { content: '05 / THE INGREDIENTS'; }
  :global(.dance-body #maybe-thats-why-it-bothers-me::before) { content: '06 / THE THROUGH-LINE'; }
  :global(.dance-body #spread-love-spread-music::before) { content: '07 / THE POINT'; color: rgba(255,196,115,.75); }
  :global(.dance-body strong) { color: #fff8e9; }

  .dance-outro {
    width: var(--reading-width);
    min-height: 58vh;
    margin: 4rem auto 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .dance-outro > p:first-child {
    margin: 0 0 1rem;
    font-family: var(--font-post-mono, monospace);
    font-size: .62rem;
    letter-spacing: .18em;
    color: rgba(255,255,255,.38);
  }
  .spread-love {
    appearance: none;
    border: 0;
    background: transparent;
    color: #fff4df;
    font-family: var(--font-display, serif);
    font-size: clamp(2.8rem, 7vw, 6.8rem);
    line-height: .95;
    letter-spacing: -.045em;
    cursor: pointer;
    text-shadow: 0 0 42px rgba(255,186,87,.12);
    transition: transform .25s ease, text-shadow .25s ease;
  }
  .spread-love:hover { transform: scale(1.015); text-shadow: 0 0 58px rgba(255,186,87,.28); }
  .spread-love__echo { min-height: 1.5em; margin-top: 1.2rem; color: rgba(255,255,255,.57); font-style: italic; }

  @keyframes beam-drift { from { transform: translateX(-50%) rotate(3deg); } to { transform: translateX(-50%) rotate(12deg); } }
  @keyframes crowd-breathe { from { opacity: .22; transform: translateY(calc((var(--i) % 7) * -10px)) scale(.75); } to { opacity: .7; transform: translateY(calc((var(--i) % 7) * -10px - 8px)) scale(1.15); } }
  @keyframes love-burst { 0% { filter: brightness(1); } 18% { filter: brightness(1.85); } 100% { filter: brightness(1); } }

  @media (max-width: 960px) {
    .platter { right: 0; bottom: 1rem; transform: scale(.8); transform-origin: bottom right; }
    .platter-hint { display: none; }
  }

  @media (max-width: 720px) {
    .dance-hero { min-height: 86vh; padding: 4rem 0 2rem; }
    .dance-hero h1 { font-size: clamp(3.2rem, 16vw, 5.8rem); }
    .journey-console { margin-top: 3rem; }
    .journey-console__choices { gap: .45rem; }
    .journey-console__choices button { font-size: .72rem; }
    :global(.dance-body) { padding-inline: .7rem; border-left: 0; border-right: 0; }
    .dance-progress { right: 7px; }
    .dance-backdrop__words { font-size: 24vw; }
    .booth-notes span:nth-child(1), .booth-notes span:nth-child(2) { display: none; }
