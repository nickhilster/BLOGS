---
import BaseLayout from './BaseLayout.astro'
import { resolvePostIdentity } from '../lib/postIdentity'

const { post, Content } = Astro.props
const { theme, styleVars } = resolvePostIdentity(post)
---

<BaseLayout
  title={`${post.data.title} | NikDesign Journal`}
  description={post.data.description}
  theme={theme}
  identityStyleVars={styleVars}
  markdownAlternate={`/posts/${post.slug}.md`}
>
  <main class="duet-shell">
    <header class="duet-hero">
      <p class="duet-eyebrow">A HUMAN / AI DOUBLE FEATURE</p>
      <h1>{post.data.hero.title}</h1>
      <p class="duet-dek">{post.data.hero.dek}</p>
      <div class="duet-cast" aria-label="Authors">
        <div><span class="duet-dot duet-dot--human"></span><strong>Nik</strong><small>The human case</small></div>
        <div><span class="duet-dot duet-dot--ai"></span><strong>David</strong><small>The machine's defense</small></div>
      </div>
      <p class="duet-instruction">Read down either side, or let the arguments interrupt each other.</p>
    </header>

    <div class="duet-rule" aria-hidden="true"><span>HUMAN</span><i></i><span>AI</span></div>
    <article class="duet-body prose"><Content /></article>
  </main>
</BaseLayout>

<style>
  :global(body:has(.duet-shell)) {
    background:
      radial-gradient(circle at 18% 10%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 32rem),
      radial-gradient(circle at 82% 28%, rgba(111, 168, 255, .12), transparent 34rem),
      var(--bg);
  }
  .duet-shell { width: min(1380px, calc(100% - 2rem)); margin: 0 auto; padding: 3rem 0 7rem; }
  .duet-hero { max-width: 1040px; margin: 4rem auto 5rem; text-align: center; }
  .duet-eyebrow, .duet-instruction, .duet-cast small, .duet-rule { font-family: var(--font-ui); text-transform: uppercase; letter-spacing: .13em; }
  .duet-eyebrow { color: var(--accent); font-size: .72rem; font-weight: 800; }
  .duet-hero h1 { font-size: clamp(3.2rem, 8vw, 8rem); line-height: .88; letter-spacing: -.065em; margin: 1.2rem 0 1.5rem; text-wrap: balance; }
  .duet-dek { color: var(--muted); font-size: clamp(1.15rem, 2vw, 1.5rem); max-width: 780px; margin: 0 auto; }
  .duet-cast { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; max-width: 620px; margin: 3rem auto 1.5rem; font-family: var(--font-ui); }
  .duet-cast div { display: grid; grid-template-columns: auto 1fr; column-gap: .7rem; text-align: left; align-items: center; padding: 1rem 1.2rem; border: 1px solid var(--border); background: color-mix(in srgb, var(--surface) 86%, transparent); }
  .duet-cast strong { font-size: 1.05rem; }
  .duet-cast small { grid-column: 2; color: var(--muted); font-size: .58rem; }
  .duet-dot { width: .7rem; height: .7rem; border-radius: 50%; grid-row: 1 / span 2; background: var(--accent); box-shadow: 0 0 18px color-mix(in srgb, var(--accent) 70%, transparent); }
  .duet-dot--ai { background: #6fa8ff; box-shadow: 0 0 18px rgba(111,168,255,.7); }
  .duet-instruction { color: var(--muted); font-size: .62rem; }
  .duet-rule { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; color: var(--muted); font-size: .6rem; margin-bottom: 2rem; }
  .duet-rule span:first-child { text-align: right; color: var(--accent); }
  .duet-rule span:last-child { color: #6fa8ff; }
  .duet-rule i { width: 1px; height: 3rem; background: linear-gradient(var(--accent), #6fa8ff); }
  :global(.duet-body) { max-width: none !important; }
  :global(.duet-pair) { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: clamp(2rem,5vw,6rem); position: relative; padding: 2.5rem 0 4.5rem; border-top: 1px solid var(--border); }
  :global(.duet-pair)::after { content:""; position:absolute; left:50%; top:0; bottom:0; width:1px; background: linear-gradient(transparent, var(--border) 8%, var(--border) 92%, transparent); }
  :global(.duet-side) { min-width: 0; }
  :global(.duet-side--human) { padding-right: clamp(.25rem,2vw,1.5rem); }
  :global(.duet-side--ai) { padding-left: clamp(.25rem,2vw,1.5rem); }
  :global(.duet-speaker) { display:inline-block; font-family:var(--font-ui); font-size:.62rem; font-weight:800; letter-spacing:.15em; text-transform:uppercase; margin-bottom:1rem; color:var(--accent); }
  :global(.duet-side--ai .duet-speaker) { color:#6fa8ff; }
  :global(.duet-side h2) { font-size:clamp(1.7rem,3vw,2.7rem); line-height:1.05; letter-spacing:-.035em; margin:.4rem 0 1.4rem; }
  :global(.duet-side p) { font-size:1.05rem; }
  :global(.duet-side strong) { color:var(--text); }
  :global(.duet-thesis) { font-size:clamp(1.6rem,3vw,2.6rem) !important; line-height:1.18; letter-spacing:-.03em; margin:2rem 0; }
  :global(.duet-side--human .duet-thesis) { border-left:3px solid var(--accent); padding-left:1.2rem; }
  :global(.duet-side--ai .duet-thesis) { border-left:3px solid #6fa8ff; padding-left:1.2rem; }
  :global(.duet-bridge) { max-width:900px; margin:1rem auto 5rem; padding:2.5rem; text-align:center; border:1px solid var(--border); background:linear-gradient(110deg,color-mix(in srgb,var(--accent) 9%,var(--surface)),color-mix(in srgb,#6fa8ff 9%,var(--surface))); }
  :global(.duet-bridge p) { font-size:clamp(1.35rem,2.4vw,2rem); margin:0; line-height:1.3; }
  @media (max-width: 760px) {
    .duet-shell { width:min(100% - 1.25rem, 680px); padding-top:1rem; }
    .duet-hero { margin:2rem auto 3rem; }
    .duet-cast { grid-template-columns:1fr; }
    .duet-rule { display:none; }
    :global(.duet-pair) { grid-template-columns:1fr; gap:2.5rem; padding:2rem .35rem 3rem; }
    :global(.duet-pair)::after { display:none; }
    :global(.duet-side--human), :global(.duet-side--ai) { padding:0; }
    :global(.duet-side--ai) { border-top:1px dashed var(--border); padding-top:2.5rem; }
    :global(.duet-bridge) { padding:1.5rem; margin-bottom:3rem; }
  }
</style>
