---
const chapters = [
  { key: 'question', label: 'Believe what?' },
  { key: 'goa', label: 'Goa' },
  { key: 'accidents', label: 'No accidents' },
  { key: 'matrix', label: 'Unread' },
  { key: 'alice', label: 'Rabbit hole' },
  { key: 'lego', label: 'Pieces' },
  { key: 'fiction', label: 'Fiction' },
  { key: 'wargames', label: 'Game / real' },
  { key: 'matters', label: 'All of it matters' },
  { key: 'believe', label: 'I believe' },
]
---

<nav class="belief-journey" aria-label="I Believe story journey">
  <div class="belief-journey__line" aria-hidden="true"><span></span></div>
  {chapters.map((chapter, index) => (
    <button class="belief-journey__dot" type="button" data-belief-jump={index} aria-label={`Jump to ${chapter.label}`} title={chapter.label}>
      <span>{chapter.label}</span>
    </button>
  ))}
</nav>

<script is:inline>
  (() => {
    const root = document.querySelector('.belief-post');
    const body = root?.querySelector('.post-body');
    const backdrop = document.querySelector('.belief-backdrop');
    const nav = document.querySelector('.belief-journey');
    if (!root || !body || !backdrop || !nav) return;

    const headings = [...body.querySelectorAll('h2')];
    const dots = [...nav.querySelectorAll('[data-belief-jump]')];
    const progress = nav.querySelector('.belief-journey__line span');
    if (!headings.length) return;

    const scenes = [
      ['question', 'radial-gradient(circle at 18% 22%, rgba(88,127,149,.42), transparent 30%), radial-gradient(circle at 82% 72%, rgba(123,79,145,.32), transparent 36%), linear-gradient(180deg,#090c14 0%,#12131d 100%)'],
      ['goa', 'radial-gradient(circle at 18% 30%, rgba(61,174,184,.48), transparent 31%), radial-gradient(circle at 78% 72%, rgba(232,159,70,.38), transparent 34%), linear-gradient(160deg,#061b22 0%,#11303a 48%,#312017 100%)'],
      ['accidents', 'radial-gradient(circle at 52% 24%, rgba(225,181,82,.38), transparent 27%), radial-gradient(circle at 18% 76%, rgba(110,153,89,.30), transparent 31%), linear-gradient(155deg,#1a180b 0%,#28200e 48%,#0d1a10 100%)'],
      ['matrix', 'linear-gradient(rgba(83,175,116,.075) 1px, transparent 1px), linear-gradient(90deg,rgba(83,175,116,.075) 1px, transparent 1px), radial-gradient(circle at 72% 30%, rgba(55,172,93,.38), transparent 29%), linear-gradient(180deg,#04100b 0%,#071c12 55%,#06110d 100%)'],
      ['alice', 'radial-gradient(circle at 20% 18%, rgba(92,115,211,.48), transparent 27%), radial-gradient(circle at 76% 28%, rgba(201,80,166,.43), transparent 30%), radial-gradient(circle at 52% 78%, rgba(76,178,160,.32), transparent 31%), linear-gradient(150deg,#0d1230 0%,#29112f 48%,#0d2225 100%)'],
      ['lego', 'linear-gradient(135deg,rgba(238,183,66,.24) 0 18%,transparent 18% 44%,rgba(68,145,194,.20) 44% 64%,transparent 64%), linear-gradient(45deg,transparent 0 68%,rgba(210,83,56,.18) 68% 82%,transparent 82%), radial-gradient(circle at 74% 68%, rgba(216,90,65,.30), transparent 30%), linear-gradient(160deg,#18171b 0%,#2b2215 50%,#101821 100%)'],
      ['fiction', 'radial-gradient(circle at 50% 18%, rgba(212,163,85,.34), transparent 29%), radial-gradient(circle at 16% 72%, rgba(70,131,142,.31), transparent 33%), linear-gradient(180deg,#1b130d 0%,#211710 48%,#0c151a 100%)'],
      ['wargames', 'linear-gradient(rgba(96,175,191,.085) 1px, transparent 1px), linear-gradient(90deg,rgba(96,175,191,.085) 1px, transparent 1px), radial-gradient(circle at 72% 34%, rgba(213,82,61,.34), transparent 28%), radial-gradient(circle at 22% 72%, rgba(55,153,176,.38), transparent 31%), #07151c'],
      ['matters', 'radial-gradient(circle at 18% 24%, rgba(168,214,200,.42), transparent 29%), radial-gradient(circle at 78% 34%, rgba(155,120,191,.36), transparent 31%), radial-gradient(circle at 52% 78%, rgba(218,171,92,.34), transparent 34%), linear-gradient(180deg,#0c1019 0%,#19131f 100%)'],
      ['believe', 'radial-gradient(circle at 50% 20%, rgba(231,205,139,.44), transparent 29%), radial-gradient(circle at 18% 74%, rgba(97,169,156,.34), transparent 31%), radial-gradient(circle at 82% 70%, rgba(129,105,166,.31), transparent 31%), linear-gradient(180deg,#11151d 0%,#1b171a 55%,#0b0d12 100%)'],
    ];

    let sceneRoot = backdrop.querySelector('.belief-scenes');
    if (!sceneRoot) {
      sceneRoot = document.createElement('div');
      sceneRoot.className = 'belief-scenes';
      Object.assign(sceneRoot.style, { position: 'absolute', inset: '-8%', zIndex: '1', overflow: 'hidden' });
      scenes.forEach(([key, background], index) => {
        const layer = document.createElement('div');
        layer.dataset.scene = key;
        Object.assign(layer.style, {
          position: 'absolute', inset: '0', opacity: index === 0 ? '1' : '0',
          transform: index === 0 ? 'scale(1)' : 'scale(1.045)',
          transition: 'opacity 1.1s ease, transform 1.5s ease',
          background,
        });
        if (key === 'matrix') layer.style.backgroundSize = '34px 34px, 34px 34px, auto, auto';
        if (key === 'wargames') layer.style.backgroundSize = '42px 42px, 42px 42px, auto, auto, auto';
        sceneRoot.appendChild(layer);
      });
      backdrop.appendChild(sceneRoot);
    }

    const field = backdrop.querySelector('.belief-backdrop__field');
    const threads = backdrop.querySelector('.belief-backdrop__threads');
    const grain = backdrop.querySelector('.belief-backdrop__grain');
    if (field) Object.assign(field.style, { zIndex: '0', opacity: '.08' });
    if (threads) Object.assign(threads.style, { zIndex: '2' });
    if (grain) Object.assign(grain.style, { zIndex: '3' });

    headings.forEach((heading, index) => {
      heading.dataset.beliefIndex = String(index);
    });

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => headings[index]?.scrollIntoView({ behavior: 'smooth', block: 'start' }));
    });

    let active = -1;
    const setActive = (index) => {
      index = Math.max(0, Math.min(index, headings.length - 1));
      if (index === active) return;
      active = index;
      const key = scenes[index]?.[0] || scenes[scenes.length - 1][0];
      backdrop.dataset.chapter = key;
      root.dataset.chapter = key;
      [...sceneRoot.children].forEach((layer, i) => {
        layer.style.opacity = i === index ? '1' : '0';
        layer.style.transform = i === index ? 'scale(1)' : 'scale(1.045)';
      });
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
      headings.forEach((heading, i) => heading.classList.toggle('is-active', i === index));
      if (progress) progress.style.transform = `scaleY(${headings.length <= 1 ? 1 : index / (headings.length - 1)})`;
    };

    const update = () => {
      const anchor = window.innerHeight * .5;
      let index = 0;
      for (let i = 0; i < headings.length; i += 1) {
        if (headings[i].getBoundingClientRect().top <= anchor) index = i;
        else break;
      }
      setActive(index);
    };

    update();
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { update(); ticking = false; });
    }, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  })();
</script>

<style>
  :global(.belief-post .post-body h2) { scroll-margin-top: 7rem; transition: color .4s ease, border-color .4s ease, transform .4s ease; }
  :global(.belief-post .post-body h2.is-active) { color: #fffaf0; border-color: rgba(168,214,200,.42); transform: translateX(.22rem); }
  .belief-journey { position: fixed; right: clamp(1rem,2.2vw,2.4rem); top: 50%; z-index: 4; display: grid; gap: .82rem; transform: translateY(-50%); }
  .belief-journey__line { position: absolute; top: .95rem; bottom: .95rem; left: 50%; width: 1px; transform: translateX(-50%); background: rgba(168,214,200,.16); overflow: hidden; }
  .belief-journey__line span { position: absolute; inset: 0; transform: scaleY(0); transform-origin: top; background: linear-gradient(180deg,#a8d6c8,#c8a770); transition: transform .7s ease; }
  .belief-journey__dot { position: relative; z-index: 1; width: .62rem; height: .62rem; padding: 0; border: 1px solid rgba(223,236,232,.46); border-radius: 50%; background: rgba(10,13,18,.88); cursor: pointer; }
  .belief-journey__dot > span { position: absolute; right: 1.15rem; top: 50%; width: max-content; transform: translate(8px,-50%); opacity: 0; color: #e9ece9; font-family: var(--font-post-mono,monospace); font-size: .68rem; background: rgba(7,9,13,.78); border: 1px solid rgba(168,214,200,.14); border-radius: .35rem; padding: .36rem .48rem; transition: opacity .2s ease, transform .2s ease; }
  .belief-journey__dot:hover, .belief-journey__dot:focus-visible, .belief-journey__dot.is-active { transform: scale(1.42); border-color: #d7e8e2; background: #a8d6c8; box-shadow: 0 0 18px rgba(168,214,200,.46); }
  .belief-journey__dot:hover > span, .belief-journey__dot:focus-visible > span { opacity: 1; transform: translate(0,-50%); }
  @media (max-width: 980px) { .belief-journey { display: none; } }
  @media (prefers-reduced-motion: reduce) { .belief-journey__line span, .belief-journey__dot, .belief-journey__dot > span { transition: none !important; } }
</style>