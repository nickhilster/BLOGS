---
import type { MotionPresetKey } from '../../lib/motion'

interface Step {
  label: string
  caption?: string
}

interface Props {
  steps: Step[]
  orientation?: 'horizontal' | 'vertical'
  motion?: MotionPresetKey
}

const { steps, orientation = 'horizontal', motion = 'branch-draw-in' } = Astro.props

const isHorizontal = orientation === 'horizontal'
const gap = 100
const nodeRadius = 20
const width = isHorizontal ? gap * (steps.length - 1) + nodeRadius * 2 : nodeRadius * 2 + 40
const height = isHorizontal ? nodeRadius * 2 + 40 : gap * (steps.length - 1) + nodeRadius * 2

const points = steps.map((_, i) => ({
  x: isHorizontal ? nodeRadius + i * gap : width / 2,
  y: isHorizontal ? height / 2 : nodeRadius + i * gap,
}))
---

<figure
  class={`flow-diagram flow-diagram--${orientation}`}
  data-motion={motion}
  style={`--flow-steps: ${steps.length}`}
>
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={steps.map((step) => step.label).join(' leads to ')}>
    {points.slice(0, -1).map((point, i) => {
      const next = points[i + 1]
      const length = Math.hypot(next.x - point.x, next.y - point.y)
      return (
        <line
          class="diagram-line"
          x1={point.x}
          y1={point.y}
          x2={next.x}
          y2={next.y}
          style={`--line-length: ${length}`}
        />
      )
    })}
    {points.map((point, i) => (
      <g class="diagram-node">
        <circle cx={point.x} cy={point.y} r={nodeRadius} />
        <text x={point.x} y={point.y} dy="0.35em" text-anchor="middle">{i + 1}</text>
      </g>
    ))}
  </svg>
  <ol class="flow-diagram__labels">
    {steps.map((step) => (
      <li>
        <strong>{step.label}</strong>
        {step.caption ? <span>{step.caption}</span> : null}
      </li>
    ))}
  </ol>
</figure>
