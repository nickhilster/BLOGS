---
import { great911Languages, getGreat911Language } from '../../lib/great911Languages'

interface Props {
  slug: string
}

const { slug } = Astro.props
const current = getGreat911Language(slug)
---

{current && (
  <nav class="language-tabs" aria-label="Article languages">
    <div class="language-tabs__inner" role="list">
      {great911Languages.map((language) => (
        <a
          role="listitem"
          href={`/posts/${language.slug}`}
          lang={language.lang}
          dir={language.dir}
          hreflang={language.lang}
          aria-current={language.slug === slug ? 'page' : undefined}
          class:list={["language-tabs__tab", { "is-active": language.slug === slug }]}
        >
          {language.label}
        </a>
      ))}
    </div>
  </nav>
)}

<style>
  .language-tabs {
    position: sticky;
    top: 0;
    z-index: 18;
    width: 100%;
    border-bottom: 1px solid rgba(255,255,255,.08);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(16px);
  }

  .language-tabs__inner {
    display: flex;
    gap: .35rem;
    width: min(100% - 2rem, 78rem);
    margin: 0 auto;
    padding: .65rem 0;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: thin;
  }

  .language-tabs__tab {
    flex: 0 0 auto;
    padding: .5rem .72rem;
    border: 1px solid transparent;
    border-radius: 999px;
    color: var(--muted);
    font-family: var(--font-post-mono, ui-monospace, monospace);
    font-size: .72rem;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: color .18s ease, background .18s ease, border-color .18s ease;
  }

  .language-tabs__tab:hover {
    color: var(--text);
    border-color: color-mix(in srgb, var(--accent) 32%, transparent);
  }

  .language-tabs__tab.is-active {
    color: var(--text);
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    border-color: color-mix(in srgb, var(--accent) 36%, transparent);
  }

  @media (max-width: 760px) {
    .language-tabs__inner {
      width: 100%;
      padding-inline: 1rem;
    }
  }
</style>
