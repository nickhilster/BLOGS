---
import { articleLocales } from '../../lib/articleLocales'

interface Props {
  current: string
}

const { current } = Astro.props
---

<nav class="article-language-rail" aria-label="Article languages">
  <div class="article-language-rail__inner" role="list">
    {articleLocales.map((item) => (
      <a
        role="listitem"
        href={item.href}
        lang={item.lang}
        dir={item.dir}
        hreflang={item.lang}
        aria-current={item.code === current ? 'page' : undefined}
        class:list={["article-language-rail__tab", { "is-active": item.code === current }]}
      >
        {item.label}
      </a>
    ))}
  </div>
</nav>

<style>
  .article-language-rail {
    position: sticky;
    top: 0;
    z-index: 18;
    width: 100%;
    border-bottom: 1px solid rgba(255,255,255,.08);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(16px);
  }

  .article-language-rail__inner {
    display: flex;
    gap: .35rem;
    width: min(100% - 2rem, 78rem);
    margin: 0 auto;
    padding: .65rem 0;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: thin;
  }

  .article-language-rail__tab {
    flex: 0 0 auto;
    padding: .5rem .72rem;
    border: 1px solid transparent;
    border-radius: 999px;
    color: var(--muted);
    font-family: var(--font-post-mono, ui-monospace, monospace);
    font-size: .72rem;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: color .18s ease, background .18s ease, border-color .18s ease;
  }

  .article-language-rail__tab:hover {
    color: var(--text);
    border-color: color-mix(in srgb, var(--accent) 32%, transparent);
  }

  .article-language-rail__tab.is-active {
    color: var(--text);
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    border-color: color-mix(in srgb, var(--accent) 36%, transparent);
  }

  @media (max-width: 760px) {
    .article-language-rail__inner {
      width: 100%;
      padding-inline: 1rem;
    }
  }
</style>
