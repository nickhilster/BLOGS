---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Operation Front Door: 191 live tests of Paradox candidate-chat assistants at 25 employers — 1 pass, 38 partial, 152 fail. A TeamBotics audit of the hiring front door, November 6, 2026." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Operation Front Door</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      :root {
        --paper: #faf6ef;
        --ink: #23201b;
        --muted: #6f675a;
        --accent: #9a3b2e;
        --press: #274b8f;
        --card: #fffdf8;
        --line: #e5dcc9;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: Georgia, 'Times New Roman', serif;
        line-height: 1.65;
      }
      a { color: var(--press); }
      .wrap { max-width: 46rem; margin: 0 auto; padding: 0 1.25rem 4rem; }
      header.site {
        border-bottom: 3px double var(--ink);
        padding: 2.25rem 0 1.25rem;
        margin-bottom: 2rem;
        text-align: center;
      }
      header.site .kicker {
        font-family: ui-sans-serif, system-ui, sans-serif;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        font-size: 0.72rem;
        color: var(--accent);
        margin: 0 0 0.5rem;
      }
      header.site h1 { font-size: 2.6rem; margin: 0; line-height: 1.1; }
      header.site h1 a { color: var(--ink); text-decoration: none; }
      header.site .tagline { color: var(--muted); font-style: italic; margin: 0.6rem 0 0; }
      footer.site {
        border-top: 1px solid var(--line);
        margin-top: 3rem;
        padding-top: 1.25rem;
        color: var(--muted);
        font-size: 0.9rem;
      }
      article.post h1 { font-size: 1.9rem; line-height: 1.25; margin: 0 0 0.5rem; }
      article.post p { margin: 0 0 1.1rem; }
      article.post ul, article.post ol { margin: 0 0 1.1rem; padding-left: 1.4rem; }
      article.post li { margin-bottom: 0.4rem; }
      article.post blockquote {
        border-left: 3px solid var(--accent);
        margin: 1.25rem 0;
        padding: 0.25rem 0 0.25rem 1rem;
        color: #4c463c;
      }
      article.post h2, article.post h3 { line-height: 1.3; margin: 1.6rem 0 0.6rem; }
      article.post table {
        border-collapse: collapse;
        width: 100%;
        font-size: 0.88rem;
        margin: 1rem 0 1.4rem;
        display: block;
        overflow-x: auto;
      }
      article.post th, article.post td {
        border: 1px solid var(--line);
        padding: 0.4rem 0.55rem;
        text-align: left;
        vertical-align: top;
      }
      article.post th { background: var(--card); }
      article.post img {
        max-width: 100%;
        height: auto;
        border: 1px solid var(--line);
        border-radius: 0.5rem;
      }
      article.post code {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.85em;
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 0.3rem;
        padding: 0.05rem 0.3rem;
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header class="site">
        <p class="kicker">TeamBotics · Toronto · An audit of the hiring front door</p>
        <h1><a href="/">Operation Front Door</a></h1>
        <p class="tagline">Every deployment tested live, from the candidate's chair, with the same eight questions.</p>
      </header>
      <slot />
      <footer class="site">
        <p>Operation Front Door is a TeamBotics investigation, conducted November 6, 2026, against live public careers sites. No applications were submitted, no accounts created, and no personal data supplied. Transcripts are published verbatim; scores follow the published protocol. <a href="/transcripts/">Evidence vault</a> · <a href="/customers/">Documented customers</a></p>
      </footer>
    </div>
  </body>
</html>
