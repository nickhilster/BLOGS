      caption: 'Browser capture from this test session: name demands in reply to E, F and G, with the full job description on the same page.',
    },
  ],
  'great-wolf-lodge-r4-emma-2026-11-06': [
    {
      src: '/images/01-great-wolf-lodge-emma-name-in-greeting.jpg',
      alt: "Browser capture of Emma demanding the candidate's first and last name in the greeting, before any question",
      caption: 'Browser capture from this test session: the name demand is in the greeting, before any question is asked.',
    },
    {
      src: '/images/02-great-wolf-lodge-emma-name-demand-loop.jpg',
      alt: 'Browser capture of Emma answering questions A through D each only with a name demand',
      caption: 'Browser capture from this test session: questions A–D answered only with name demands.',
    },
  ],
  'fedex-olivia-2026-11-06': [
    {
      src: '/images/03-fedex-olivia-claim-and-name-demands.jpg',
