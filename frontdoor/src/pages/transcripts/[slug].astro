---
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  const modules = import.meta.glob('../../content/transcripts/*.md', { eager: true });
  return Object.entries(modules).map(([path, mod]: [string, any]) => {
    const slug = path.split('/').pop()!.replace(/\.md$/, '');
    return { params: { slug }, props: { mod, slug } };
  });
}

const { mod, slug } = Astro.props;
const Content = mod.default;
const headings = typeof mod.getHeadings === 'function' ? mod.getHeadings() : [];
const h1 = headings.find((h: any) => h.depth === 1);
const title = h1 ? h1.text : slug;

const unconfirmed = slug.includes('vendor-unconfirmed');

const shots: Record<string, { src: string; alt: string; caption: string }[]> = {
  'mcdonalds-canada-olivia-2026-11-06': [
    {
      src: '/images/01-mcdonalds-canada-olivia-guest-experience-leader.png',
      alt: "Screenshot of McDonald's Canada's Olivia answering the question 'what is a guest experience leader?' with a redirection to the job descriptions",
      caption: 'The same deployment and question, captured by the commissioner on the morning of November 6, 2026 — before this test session.',
    },
    {
      src: '/images/04-chatgpt-comparison-guest-experience-leader.png',
      alt: "Screenshot of a general-purpose assistant answering the question 'what is a guest experience leader?' with a substantive role description",
      caption: "The commissioner's own comparison: a general-purpose assistant answering the same question. Not part of this audit's testing.",
    },
  ],
  'chipotle-ava-cado-2026-11-06': [
    {
      src: '/images/02-chipotle-ava-cado-service-leader.png',
      alt: "Screenshot of Chipotle's Ava Cado answering a question about the Service Leader role with corporate messaging, then requesting an email",
      caption: 'Captured by the commissioner on the morning of November 6, 2026: the role question answered with corporate messaging, then a request for an email.',
    },
    {
      src: '/images/03-chipotle-ava-cado-form-instead-of-chatbot.png',
