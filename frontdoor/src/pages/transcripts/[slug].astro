      caption: 'Browser capture from this test session: the Toronto denial, against the Tyler, TX posting open behind the panel.',
    },
  ],
  'crocs-olivia-2026-11-06': [
    {
      src: '/images/06-crocs-olivia-question-unanswered.jpg',
      alt: "Browser capture of the chat panel with the question 'what is a sales associate?' unanswered as the last message",
      caption: 'Browser capture from this session’s first attempt: the question sits unanswered as the last message in the panel. A still shows the unanswered state, not the elapsed time — the wait rests on an identical capture taken 22 seconds later and on the transcript above.',
    },
  ],
  'mckesson-gia-2026-11-06': [
    {
      src: '/images/07-mckesson-gia-no-specific-details.jpg',
      alt: "Browser capture of Gia stating it does not have the specific details about the role's skills or responsibilities",
      caption: 'Browser capture from this test session: “I don’t have the specific details about the skills for the Warehouse Worker role.”',
    },
  ],
  't-mobile-cass-2026-11-06': [
    {
      src: '/images/08-t-mobile-cass-claim-and-deflection.jpg',
      alt: 'Browser capture of CASS making the question-answering claim, then deflecting the role question to the job description',
      caption: 'Browser capture from this test session: the claim at F, and the deflection to the job description at G.',
    },
  ],
  'whole-foods-sage-2026-11-06': [
    {
      src: '/images/07-whole-foods-sage-claim-and-name-demands.jpg',
      alt: 'Browser capture of Sage making its question-answering claim between name demands',
      caption: 'Browser capture from this test session: the question-answering claim, between name demands.',
    },
  ],
};
const pageShots = shots[slug] ?? [];
---
<Base title={title} description={`Operation Front Door transcript: ${title}. Tested live on November 6, 2026.`}>
  <style>
    .fence {
      border: 2px dashed var(--accent);
      border-radius: 0.6rem;
      padding: 0.9rem 1.2rem;
      margin-bottom: 1.6rem;
      background: #fdf3ee;
      font-size: 0.95rem;
    }
    .fence strong { color: var(--accent); }
    figure.shot { margin: 1.4rem 0; }
    figure.shot img {
      width: 100%;
      border: 1px solid var(--line);
      border-radius: 0.5rem;
      box-shadow: 0 8px 24px rgba(35, 32, 27, 0.10);
    }
    figure.shot figcaption { font-size: 0.85rem; color: var(--muted); margin-top: 0.45rem; }
    .shot-hint { font-style: italic; }
  </style>
  <article class="post">
    {unconfirmed && (
      <div class="fence">
        <strong>Vendor-unconfirmed — filed separately.</strong> No Paradox attribution was visible anywhere in this session, so this result is <strong>not charged to Paradox</strong>. It is published as a control / comparison record only.
      </div>
    )}
    <Content />
    {pageShots.map((s) => (
      <figure class="shot">
        <a class="shot-link" href={s.src} target="_blank" rel="noopener" title="View full size — original capture">
          <img src={s.src} alt={s.alt} loading="lazy" />
        </a>
        <figcaption>{s.caption} <span class="shot-hint">Click the frame to view it full size.</span></figcaption>
      </figure>
    ))}
    <p style="margin-top:2.5rem;"><a href="/transcripts/">← All transcripts</a> · <a href="/">Findings</a></p>
  </article>
</Base>
