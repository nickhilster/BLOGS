      caption: 'Captured by the commissioner, November 6, 2026: asked for a form instead of the chatbot, the assistant returns to requesting a legal first and last name.',
    },
    {
      src: '/images/05-chatgpt-comparison-service-leader.png',
      alt: "Screenshot of a general-purpose assistant answering a question about Chipotle's Service Leader role with a substantive role description",
      caption: "The commissioner's own comparison: a general-purpose assistant answering the same role question. Not part of this audit's testing.",
    },
  ],
  'accenture-amethyst-2026-11-06': [
    {
      src: '/images/01-accenture-amethyst-test-test-bella-admin-test.jpg',
      alt: "Browser capture of Amethyst ending a reply with 'TEST TEST BELLA ADMIN TEST', footer 'Powered by Paradox'",
      caption: 'Browser capture from this test session, November 6, 2026: the reply ending in the internal string “TEST TEST BELLA ADMIN TEST.”',
    },
  ],
  'compass-group-olivia-2026-11-06': [
    {
      src: '/images/03-compass-olivia-name-before-questions.jpg',
      alt: 'Browser capture of the Compass session opening with a demand for a first and last name before any question is answered',
      caption: 'Browser capture from this test session: the session opens with a name demand, before any question is answered.',
    },
    {
      src: '/images/02-compass-olivia-no-positions-open-denial.jpg',
      alt: "Browser capture of Olivia stating 'We don't currently have any positions open' in a session launched from a live posting",
      caption: 'Browser capture from this test session: the false denial, followed by another name demand.',
    },
    {
      src: '/images/04-compass-olivia-form-route-and-name-demands.jpg',
      alt: 'Browser capture of the session end, showing the Apply Now form-route answer between further name demands',
      caption: 'Browser capture from this test session: the investigation’s only PASS (question E, the Apply Now route) between further name demands.',
    },
  ],
  'papa-johns-pepper-2026-11-06': [
    {
      src: '/images/05-papa-johns-pepper-name-demand-loop.jpg',
      alt: "Browser capture of Pepper answering questions D through G only with name demands",
      caption: 'Browser capture from this test session: questions D–G answered only with name demands.',
    },
  ],
  'pepsico-askpep-2026-11-06': [
    {
      src: '/images/06-pepsico-askpep-name-demand-loop.jpg',
