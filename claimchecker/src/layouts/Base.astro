---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "ClaimChecker is the investigative practice of TeamBotics: we check what companies and platforms say against what their own products, pages and records show — and publish the evidence." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — ClaimChecker</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      :root {
        --paper: #faf6ef;
        --ink: #23201b;
        --muted: #6f675a;
        --accent: #9a3b2e;
        --press: #274b8f;
        --card: #fffdf8;
        --line: #e5dcc9;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: Georgia, 'Times New Roman', serif;
        line-height: 1.65;
      }
      a { color: var(--press); }
      .wrap { max-width: 46rem; margin: 0 auto; padding: 0 1.25rem 4rem; }
      header.site {
        border-bottom: 3px double var(--ink);
        padding: 2.25rem 0 1.25rem;
        margin-bottom: 2rem;
        text-align: center;
      }
      header.site .kicker {
        font-family: ui-sans-serif, system-ui, sans-serif;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        font-size: 0.72rem;
        color: var(--accent);
        margin: 0 0 0.5rem;
      }
      header.site h1 { font-size: 2.6rem; margin: 0; line-height: 1.1; }
      header.site h1 a { color: var(--ink); text-decoration: none; }
      header.site .tagline { color: var(--muted); font-style: italic; margin: 0.6rem 0 0; }
      footer.site {
        border-top: 1px solid var(--line);
        margin-top: 3rem;
        padding-top: 1.25rem;
        color: var(--muted);
        font-size: 0.9rem;
      }
      article.post h1 { font-size: 1.9rem; line-height: 1.25; margin: 0 0 0.5rem; }
      article.post p { margin: 0 0 1.1rem; }
      article.post ul, article.post ol { margin: 0 0 1.1rem; padding-left: 1.4rem; }
      article.post li { margin-bottom: 0.4rem; }
      article.post blockquote {
        border-left: 3px solid var(--accent);
        margin: 1.25rem 0;
        padding: 0.25rem 0 0.25rem 1rem;
        color: #4c463c;
      }
      article.post h2, article.post h3 { line-height: 1.3; margin: 1.6rem 0 0.6rem; }
    </style>
    <style is:global>
      u { text-decoration-thickness: 1px; text-underline-offset: 3px; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header class="site">
        <p class="kicker">TeamBotics · Toronto · Investigative practice</p>
        <h1><a href="/">ClaimChecker</a></h1>
        <p class="tagline">Claims are cheap. Receipts are not.</p>
      </header>
      <slot />
      <footer class="site">
        <p>ClaimChecker is the investigative practice of <a href="https://teambotics.app">TeamBotics</a>, Toronto. Published investigations: <a href="https://frontdoor.teambotics.app">Operation Front Door</a> · <a href="https://escapedboardy.teambotics.app">Escaped Boardy</a>. We publish our corrections with our findings — if the record is wrong, the correction goes on the record, where the finding was.</p>
      </footer>
    </div>
  </body>
</html>
